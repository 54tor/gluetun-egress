# --- commun -----------------------------------------------------------------
TZ=Europe/Paris

# Port d'écoute de l'application dans le namespace du gateway (Caddy -> 172.30.20.2:APP_PORT)
APP_PORT=8080

# --- health checks du gateway ----------------------------------------------
# Cibles HTTPS par IP (aucune dépendance DNS). Succès si UNE cible répond.
PROBE_URLS=https://9.9.9.9/ https://8.8.8.8/
PROBE_URLS6=https://[2620:fe::fe]/ https://[2001:4860:4860::8888]/
PROBE_INTERVAL=5
PROBE_TIMEOUT=4
# Échecs consécutifs avant de déclarer un VPN mort / succès consécutifs avant de le réintégrer
FAIL_THRESHOLD=3
RISE_THRESHOLD=3

# Retest périodique du débit et de la latence d'un serveur VPN (vpn-check.sh), en secondes. 0 : jamais. Ex. 1800.
VPN_CHECK_RECHECK_SECONDS=0

# --- fournisseurs VPN ------------------------------------------------------
# Créer .env.vpn1, .env.vpn2, .env.vpn3 (un par Gluetun, ordre de priorité) avec les variables Gluetun du fournisseur.
# Exemple .env.vpn1 (WireGuard) :
#   VPN_SERVICE_PROVIDER=mullvad
#   VPN_TYPE=wireguard
#   WIREGUARD_PRIVATE_KEY=...
#   WIREGUARD_ADDRESSES=10.64.0.2/32,fc00:bbbb:bbbb:bb01::1/128   # la 2e adresse active l'IPv6 de ce Gluetun
#   SERVER_CITIES=Amsterdam
# Exemple .env.vpn2 (OpenVPN) :
#   VPN_SERVICE_PROVIDER=protonvpn
#   VPN_TYPE=openvpn
#   OPENVPN_USER=...
#   OPENVPN_PASSWORD=...
#   SERVER_COUNTRIES=Switzerland
# Ne PAS définir VPN_INTERFACE ni FIREWALL_* dans ces fichiers (fixés par docker-compose.yml).
