# Caddy -> application, en direct sur le réseau vpn-gateway (L2), jamais via un Gluetun.
# 172.30.20.2 = IP du gateway, dont l'application partage le namespace réseau.
{
	admin off
	auto_https off
	servers {
		# Les trois connecteurs wgentry, vus de Caddy (leur adresse sur `frontend`) : eux seuls sont crus
		# sur X-Forwarded-For ; sans eux Caddy verrait l'adresse du connecteur, pas celle du client.
		trusted_proxies static 172.30.10.11/32 172.30.10.12/32 172.30.10.13/32
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	respond /healthz 200
	reverse_proxy 172.30.20.2:{$APP_PORT}
}
